{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Turborepo sanitiza el entorno para que los builds sean herméticos:
      // una variable no declarada no llega al proceso aunque exista en la
      // plataforma. Se declara en la tarea global porque Vercel la expone a
      // todo el proyecto y, si solo la declara web, Turbo sigue avisando por
      // core-domain. El costo es que un cambio de valor invalida la cache de
      // core-domain, que rebuildea en ~2s.
      "env": ["INDINV_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@indinv/web#typecheck": {
      // Next genera los tipos de rutas en .next/types DURANTE el build, y el
      // tsconfig los incluye. Sin esta dependencia turbo puede correr el
      // typecheck en paralelo al build y fallar con TS6053 (archivo no
      // encontrado) por una simple carrera, no por un error real de tipos.
      "dependsOn": ["^build", "@indinv/web#build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
